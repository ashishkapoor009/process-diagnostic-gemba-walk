# ---------------------------------------------------------------------------
# Process Diagnostic / Gemba Walk Multi-Agent Solution - Environment Config
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- LLM Provider: "openai" or "azure_openai" ---
LLM_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# --- Azure OpenAI (used only when LLM_PROVIDER=azure_openai) ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# --- App behaviour ---
APP_ENV=development
LOG_LEVEL=INFO
RAGAS_MIN_SCORE=0.70
MAX_REVIEW_ROUNDS=1
TARGET_EFFICIENCY_LOW=0.25
TARGET_EFFICIENCY_HIGH=0.30

# --- Storage paths ---
SQLITE_DB_PATH=./data/pe_agent.db
CHROMA_PERSIST_DIR=./data/chroma
UPLOAD_DIR=./data/uploads

# --- Retention / persistence backup ---
# Diagnostics are kept for at least this many days regardless of storage
# pressure; once the SQLite file exceeds MAX_STORAGE_MB, the oldest process
# older than this is deleted (oldest-first) until back under budget.
MIN_RETENTION_DAYS=90
MAX_STORAGE_MB=500
# GCS bucket the SQLite file is backed up to / restored from on startup, so
# diagnostics survive a redeploy (the container filesystem is ephemeral).
# Leave empty to disable (local dev default) - see app/database/backup.py.
GCS_BACKUP_BUCKET=

# --- OCR ---
TESSERACT_CMD=tesseract

# --- FastAPI backend (optional) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
